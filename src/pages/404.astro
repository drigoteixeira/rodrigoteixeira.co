---
import Base from '../layouts/Base.astro';
---
<Base lang="pt" current="home" page="" noindex title="Página não encontrada · Rodrigo Teixeira" description="Página não encontrada. Page not found.">
  <section class="container nf">
    <p class="display-xl">404</p>
    <p class="statement">Não encontrei esta página. <span lang="en">This page doesn't exist.</span></p>
    <p class="links">
      <a href="/pt/">Ir para a Home</a>
      <span aria-hidden="true">·</span>
      <a lang="en" href="/en/">Go to Home</a>
    </p>
  </section>
</Base>

<style>
  .nf { padding-top: var(--gap-xl); padding-bottom: var(--gap-xl); display: grid; gap: 24px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }
  .links a { padding: 12px 0; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
</style>
