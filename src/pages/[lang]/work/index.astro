---
import Base from '../../../layouts/Base.astro';
import MediaBlock from '../../../components/MediaBlock.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import Words from '../../../components/Words.astro';
import { t, langs, path, cases, caseNames, type Lang } from '../../../lib/i18n';
import { breadcrumbLd, abs } from '../../../lib/seo';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t('work', lang);
const title = lang === 'pt' ? 'Cases selecionados · Rodrigo Teixeira' : 'Selected work · Rodrigo Teixeira';
const description = lang === 'pt'
  ? 'Cases de Rodrigo Teixeira: Atlantic, Preferência à Vida e Riachuelo. Design de produto, discovery e estratégia para empresas e campanhas.'
  : 'Work by Rodrigo Teixeira: Atlantic, Preferência à Vida and Riachuelo. Product design, discovery and strategy for companies and campaigns.';
const crumbs = breadcrumbLd([
  { name: 'Rodrigo Teixeira', url: abs(path(lang, '')) },
  { name: 'Work', url: abs(path(lang, 'work')) },
]);
const others = [
  { name: 'Porto Seguro', text: c.p1 },
  { name: 'Consa', text: c.p2 },
  { name: 'Educação SP', text: c.p3 },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} current="work" page="work" title={title} description={description} og={`/og/work-${lang}.png`} ogAlt={title} ld={[crumbs]}>
  <section class="top container" aria-labelledby="work-title">
    <h1 id="work-title" class="display-xl"><Words text={c.workTitle} /><sup class="top__count tabular intro-fade" style="--d:300ms">({pad(cases.length)})</sup></h1>
  </section>

  <section id="cases" class="cases container" aria-labelledby="cases-title">
    <h2 id="cases-title" class="sr-only">{c.cases}</h2>
    <ol class="index">
      {cases.map((k, i) => (
        <li class="row">
          <a class="case row__link" href={path(lang, `work/${k.slug}` as any)}>
            <div class="row__text reveal">
              <span class="row__idx tabular" aria-hidden="true">{pad(i + 1)}</span>
              <h3 class="row__name display-l">{caseNames[k.slug]}</h3>
              <p class="row__ctx">{c[k.ctx]}</p>
              <p class="row__meta mono-label"><span class="tabular">{k.year}</span><span class="row__arrow" aria-hidden="true">→</span></p>
            </div>
            <div class="row__media">
              <MediaBlock image={k.img} lang={lang} ar={['3 / 2', '3 / 2', '4 / 5']} eager={i === 0} vt={`case-${k.slug}`} delay={120} sizes="(min-width: 1024px) 58vw, 100vw" />
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section id="other" class="other container" aria-labelledby="other-title">
    <div class="grid">
      <div class="other__label reveal"><SectionLabel id="other-title">{c.other}</SectionLabel></div>
      <ul class="other__list">
        {others.map((o, i) => (
          <li class="reveal" style={`--d:${[0, 70, 120][i]}ms`}>
            <h3 class="statement">{o.name}</h3>
            <p>{o.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .top { padding-top: 56px; padding-bottom: 40px; }
  .top__count { margin-left: .2em; font-family: var(--font-text); font-size: .22em; letter-spacing: 0; font-weight: 500; vertical-align: top; position: relative; top: .5em; color: var(--color-accent); }

  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .row { border-bottom: 1px solid var(--color-line); }
  .row__link { display: grid; gap: 20px; padding: 24px 0 32px; }
  .row__text { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; align-content: start; }
  .row__idx { grid-row: 1; padding-top: .55em; font-size: var(--text-label); font-weight: 500; color: var(--color-accent); }
  .row__name { grid-column: 2; }
  .row__ctx, .row__meta { grid-column: 2; }
  .row__ctx { margin-top: 16px; max-width: 40ch; line-height: 1.55; color: var(--color-ink-2); }
  .row__meta { margin-top: 20px; display: flex; gap: 12px; align-items: center; color: var(--color-muted); }
  .row__arrow { color: var(--color-accent); opacity: 0; transform: translateX(-6px); transition: opacity var(--dur-hover) ease, transform var(--dur-hover) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .row__link:hover .row__arrow { opacity: 1; transform: none; } }
  .row__link:focus-visible .row__arrow { opacity: 1; transform: none; }

  .other { padding-top: var(--gap-xl); padding-bottom: var(--gap-l); }
  .other__label, .other__list { grid-column: 1 / -1; }
  .other__label { margin-bottom: 16px; }
  .other__list { list-style: none; margin: 0; padding: 0; }
  .other__list li { border-top: 1px solid var(--color-line); padding: 24px 0; display: grid; gap: 12px var(--gutter); }
  .other__list li:last-child { border-bottom: 1px solid var(--color-line); }
  .other__list p { max-width: 62ch; line-height: 1.6; color: var(--color-ink-2); }

  @media (min-width: 640px) {
    .top { padding-top: 72px; padding-bottom: 56px; }
    .row__link { padding: 32px 0 40px; }
    .other__label { grid-column: 1 / span 2; margin: 6px 0 0; }
    .other__list { grid-column: 3 / span 6; }
  }
  @media (min-width: 1024px) {
    .top { padding-top: 104px; padding-bottom: 72px; }
    .row__link { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding: 40px 0; }
    .row__text { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + 32px); align-self: start; }
    .row__media { grid-column: 6 / span 7; }
    .other__label { grid-column: 1 / span 3; margin-top: 10px; }
    .other__list { grid-column: 5 / span 7; }
    .other__list li { padding: 28px 0; grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .other__list h3 { grid-column: 1 / span 3; }
    .other__list p { grid-column: 4 / span 4; }
  }
  @media (prefers-reduced-motion: reduce) { .row__arrow { transform: none; transition: opacity var(--dur-hover) ease; } }
</style>
