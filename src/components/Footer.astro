---
import { path, MAILTO, EMAIL, social, common, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = common(lang);
---
<footer id="contact" class="footer">
  <div class="container footer__in">
    <h2 class="display-l footer__title">{c.ctaTitle}</h2>
    <p class="footer__body">{c.ctaBody}</p>
    <p class="footer__mail"><a href={MAILTO}>{EMAIL}</a></p>

    <div class="grid footer__cols">
      <nav aria-label={c.navigate} class="col col--a">
        <p class="col__title">{c.navigate}</p>
        <ul>
          <li><a class="flink" href={path(lang, '')}>Home</a></li>
          <li><a class="flink" href={path(lang, 'about')}>About</a></li>
          <li><a class="flink" href={path(lang, 'work')}>Work</a></li>
        </ul>
      </nav>
      <nav aria-label="Social" class="col col--b">
        <p class="col__title">Social</p>
        <ul>
          {social.map((s) => (
            <li><a class="flink" href={s.href} target="_blank" rel="noopener">{s.name} <span aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="footer__copy">© 2026 Rodrigo Teixeira</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-dark); color: var(--color-dark-ink); border-radius: var(--radius-media) var(--radius-media) 0 0; }
  .footer__in { padding-top: 48px; padding-bottom: 32px; }
  .footer__title { max-width: 14ch; }
  .footer__body { margin-top: 32px; max-width: 52ch; font-size: clamp(1.0625rem, 1rem + .3vw, 1.25rem); line-height: 1.5; color: var(--color-dark-muted); }
  .footer__mail { margin-top: 40px; }
  .footer__mail a { font-size: var(--text-statement); line-height: 1.2; letter-spacing: -.02em; font-weight: 450; color: var(--color-accent-soft); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px; overflow-wrap: anywhere; }
  .footer__cols { margin-top: 64px; row-gap: 32px; align-items: start; }
  .col { grid-column: span 2; }
  .col__title { margin-bottom: 8px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; color: var(--color-dark-ink); }
  ul { list-style: none; margin: 0; padding: 0; font-size: var(--text-small); line-height: 1.5; }
  li { padding: 6px 0; }
  .flink { color: var(--color-dark-muted); transition: color 200ms; }
  @media (hover: hover) { .flink:hover { color: var(--color-dark-ink); } }
  .footer__copy { margin-top: 64px; font-size: var(--text-small); line-height: 1.5; color: var(--color-dark-muted); }
  @media (min-width: 640px) {
    .footer__in { padding-top: 64px; padding-bottom: 32px; }
    .col--a { grid-column: 3 / span 3; } .col--b { grid-column: 6 / span 3; }
    .footer__copy { margin-top: 80px; }
  }
  @media (min-width: 1024px) {
    .footer__in { padding-top: 96px; padding-bottom: 40px; }
    .col--a { grid-column: 7 / span 3; } .col--b { grid-column: 10 / span 3; }
  }
  @media (prefers-reduced-motion: reduce) { .flink { transition: none; } }
</style>
