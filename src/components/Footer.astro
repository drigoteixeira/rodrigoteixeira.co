---
import { path, MAILTO, EMAIL, social, common, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = common(lang);
const year = new Date().getFullYear();
---
<footer id="contact" class="footer">
  <div class="container footer__in">
    <div class="grid footer__top">
      <h2 class="display-xl footer__title reveal">{c.ctaTitle}</h2>
      <div class="footer__side reveal" style="--d:100ms">
        <p class="footer__body">{c.ctaBody}</p>
        <div class="footer__mail">
          <a href={MAILTO}><span class="ul">{EMAIL}</span></a>
          <button class="copy" type="button" data-copy={EMAIL} hidden>
            <span class="copy__a" aria-hidden="true">{c.copy}</span>
            <span class="copy__b" aria-hidden="true">{c.copied}</span>
            <span class="sr-only">{c.copy}</span>
          </button>
          <span class="sr-only" aria-live="polite" data-copy-status></span>
        </div>
      </div>
    </div>

    <div class="grid footer__cols">
      <nav aria-label={c.navigate} class="col col--a">
        <p class="col__title">{c.navigate}</p>
        <ul>
          <li><a class="flink" href={path(lang, '')}>Home</a></li>
          <li><a class="flink" href={path(lang, 'about')}>About</a></li>
          <li><a class="flink" href={path(lang, 'work')}>Work</a></li>
        </ul>
      </nav>
      <nav aria-label="Social" class="col col--b">
        <p class="col__title">Social</p>
        <ul>
          {social.map((s) => (
            <li><a class="flink" href={s.href} target="_blank" rel="noopener">{s.name} <span class="flink__ar" aria-hidden="true">↗</span><span class="sr-only"> {c.newTab}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} Rodrigo Teixeira</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-dark); color: var(--color-dark-ink); border-radius: var(--radius-media) var(--radius-media) 0 0; }
  .footer__in { padding-top: 56px; padding-bottom: 28px; }
  .footer__top { row-gap: 32px; align-items: end; }
  .footer__title, .footer__side { grid-column: 1 / -1; }
  .footer__title { max-width: 10ch; }
  .footer__body { max-width: 44ch; font-size: clamp(1rem, .95rem + .25vw, 1.125rem); line-height: 1.6; color: var(--color-dark-muted); }
  .footer__mail { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .footer__mail a { font-size: clamp(1.25rem, .95rem + 1vw, 2rem); line-height: 1.2; letter-spacing: -.02em; font-weight: 450; color: var(--color-accent-soft); overflow-wrap: anywhere; }
  .ul { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; padding-bottom: 4px; transition: background-size var(--dur-hover) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .footer__mail a:hover .ul { background-size: 0 1px; background-position: 100% 100%; } }

  /* Copiar e-mail: o rótulo troca com um leve desfoque para ler como um só objeto */
  .copy { position: relative; display: inline-grid; height: 36px; padding: 0 14px; border: 1px solid color-mix(in srgb, var(--color-dark-ink) 22%, transparent); border-radius: var(--radius-pill); background: none; color: var(--color-dark-ink); font-size: var(--text-label); font-weight: 500; letter-spacing: .01em; cursor: pointer; transition: transform var(--dur-press) var(--ease-out), border-color var(--dur-hover) ease; }
  .copy > span[aria-hidden] { grid-area: 1 / 1; align-self: center; transition: opacity 200ms ease, filter 200ms ease, transform 200ms var(--ease-out); }
  .copy__b { opacity: 0; filter: blur(2px); transform: translateY(4px); color: var(--color-accent-soft); }
  .copy.is-done .copy__a { opacity: 0; filter: blur(2px); transform: translateY(-4px); }
  .copy.is-done .copy__b { opacity: 1; filter: none; transform: none; }
  .copy:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .copy:hover { border-color: color-mix(in srgb, var(--color-dark-ink) 50%, transparent); } }

  .footer__cols { margin-top: 72px; padding-top: 28px; border-top: 1px solid color-mix(in srgb, var(--color-dark-ink) 14%, transparent); row-gap: 32px; align-items: start; }
  .col { grid-column: span 2; }
  .col__title { margin-bottom: 8px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; color: var(--color-dark-ink); }
  ul { list-style: none; margin: 0; padding: 0; font-size: var(--text-small); line-height: 1.5; }
  li { padding: 6px 0; }
  .flink { display: inline-flex; gap: 6px; color: var(--color-dark-muted); transition: color var(--dur-hover) ease; }
  .flink__ar { display: inline-block; transition: transform var(--dur-hover) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .flink:hover { color: var(--color-dark-ink); }
    .flink:hover .flink__ar { transform: translate(2px, -2px); }
  }
  .footer__bottom { margin-top: 72px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: var(--text-small); line-height: 1.5; color: var(--color-dark-muted); }

  @media (min-width: 640px) {
    .footer__in { padding-top: 80px; }
    .col--a { grid-column: 1 / span 3; } .col--b { grid-column: 4 / span 3; }
  }
  @media (min-width: 1024px) {
    .footer__in { padding-top: 120px; padding-bottom: 36px; }
    .footer__title { grid-column: 1 / span 7; }
    .footer__side { grid-column: 8 / span 5; }
    .footer__cols { margin-top: 120px; }
    .col--a { grid-column: 9 / span 2; } .col--b { grid-column: 11 / span 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flink, .flink__ar, .ul, .copy, .copy > span[aria-hidden] { transition: none; }
  }
</style>
