---
import LangSwitch from './LangSwitch.astro';
import { path, MAILTO, EMAIL, type Lang } from '../lib/i18n';
import { common } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** Página atual, para marcar o link e o ponto de acento */
  current: 'home' | 'work' | 'about';
  /** Endereço da mesma página no outro idioma, sem o prefixo do idioma. Ex.: 'work/atlantic' */
  page: '' | 'work' | 'about' | 'work/atlantic' | 'work/preferencia' | 'work/riachuelo';
}
const { lang, current, page } = Astro.props;
const c = common(lang);
const home = path(lang, '');
const links = [
  { key: 'work', label: 'Work', href: path(lang, 'work') },
  { key: 'about', label: 'About', href: path(lang, 'about') },
];
const ptHref = path('pt', page);
const enHref = path('en', page);
---
<header class="site-header" data-header>
  <div class="container site-header__in">
    <a class="brand" href={home} aria-current={current === 'home' ? 'page' : undefined}>Rodrigo Teixeira</a>

    <nav class="desk" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined} class:list={{ cur: current === l.key }}>
          {current === l.key && <span class="dot" aria-hidden="true"></span>}{l.label}
        </a>
      ))}
      <a href={MAILTO}>Contact</a>
      <LangSwitch lang={lang} ptHref={ptHref} enHref={enHref} />
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-open aria-label={c.openMenu}>
      Menu <span aria-hidden="true">+</span>
    </button>
  </div>
</header>

<div class="menu" id="menu" hidden role="dialog" aria-modal="true" aria-label={lang === 'pt' ? 'Menu principal' : 'Main menu'} data-menu>
  <div class="menu__top">
    <a class="brand" href={home}>Rodrigo Teixeira</a>
    <button class="menu-btn" type="button" data-menu-close aria-label={c.closeLabel}>{c.close} <span aria-hidden="true">×</span></button>
  </div>
  <nav class="menu__nav" aria-label={lang === 'pt' ? 'Principal' : 'Main'}>
    <ul>
      {links.map((l) => (
        <li>
          <a class="mlink" href={l.href} aria-current={current === l.key ? 'page' : undefined}>
            <span class="md" aria-hidden="true"></span><span>{l.label}</span>
          </a>
        </li>
      ))}
      <li>
        <a class="mlink" href={MAILTO}>
          <span class="md" aria-hidden="true"></span><span>Contact</span><span class="ext" aria-hidden="true">↗</span>
        </a>
      </li>
      <li class="end" aria-hidden="true"></li>
    </ul>
  </nav>
  <div class="menu__bottom">
    <LangSwitch lang={lang} ptHref={ptHref} enHref={enHref} />
    <a class="menu__mail" href={MAILTO}>{EMAIL}</a>
  </div>
</div>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; height: var(--header-h); transition: background 200ms; }
  .site-header.is-scrolled { background: color-mix(in srgb, var(--color-bg) 80%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .site-header__in { height: 100%; display: flex; align-items: center; justify-content: space-between; }
  .brand, .desk, .menu-btn, .lang { font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; }
  .brand { padding: 14px 0; }
  .desk { display: none; align-items: center; gap: 32px; }
  .desk a { padding: 14px 0; display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--color-accent); }
  .menu-btn { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 4px; border: 0; background: none; cursor: pointer; }
  @media (min-width: 1024px) { .desk { display: flex; } .site-header .menu-btn { display: none; } }

  /* Menu em tela cheia (tablet e mobile) */
  .menu { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; background: var(--color-bg); overflow-y: auto; }
  .menu[hidden] { display: none; }
  .menu__top { height: var(--header-h); padding-inline: var(--margin); display: flex; align-items: center; justify-content: space-between; }
  .menu__nav { padding: 30px var(--margin) 0; }
  .menu__nav ul { list-style: none; margin: 0; padding: 0; }
  .menu__nav li { border-top: 1px solid var(--color-line); }
  .mlink { display: flex; align-items: center; gap: 12px; min-height: 76px; font-family: var(--font-display); font-size: clamp(2.25rem, 1.2rem + 3vw, 4rem); line-height: 1; letter-spacing: -.035em; font-weight: 500; }
  .md { flex: none; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--color-accent); opacity: 0; transition: opacity 200ms; }
  .mlink[aria-current="page"] .md { opacity: 1; }
  .ext { margin-left: auto; font-family: var(--font-text); font-size: 18px; letter-spacing: 0; font-weight: 400; color: var(--color-muted); }
  @media (hover: hover) { .mlink:hover .md { opacity: .45; } .mlink[aria-current="page"]:hover .md { opacity: 1; } }
  .menu__bottom { margin-top: auto; padding: 32px var(--margin); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .menu__mail { padding: 14px 0; font-size: var(--text-small); line-height: 1.5; color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  @media (prefers-reduced-motion: reduce) { .md, .site-header { transition: none; } }
</style>
