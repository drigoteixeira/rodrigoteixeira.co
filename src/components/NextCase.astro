---
interface Props { href: string; label: string; name: string; year: string }
const { href, label, name, year } = Astro.props;
---
<section aria-labelledby="next-t" class="container next">
  <a class="case next__link" href={href}>
    <h2 id="next-t" class="label"><span class="dot" aria-hidden="true"></span>{label}</h2>
    <div class="next__row">
      <span class="display-l">{name} <span aria-hidden="true">→</span></span>
      <span class="next__year tabular">{year}</span>
    </div>
  </a>
</section>

<style>
  .next { padding-block: var(--gap-xl); }
  .next__link { display: block; border-top: 1px solid var(--color-line); padding-top: 28px; }
  .label { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--color-accent); }
  .next__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .next__year { line-height: 1.6; color: var(--color-muted); }
</style>
