---
// Rótulo de seção: ponto de acento (ou número da seção) + texto.
interface Props { tag?: 'h2' | 'p'; id?: string; index?: string }
const { tag = 'h2', id, index } = Astro.props;
const Tag = tag;
---
<Tag class="label" id={id}>
  {index ? <span class="num tabular" aria-hidden="true">{index}</span> : <span class="dot" aria-hidden="true"></span>}
  <span><slot /></span>
</Tag>

<style>
  .label { display: flex; align-items: baseline; gap: 10px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; }
  .dot { flex: none; align-self: center; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--color-accent); }
  .num { flex: none; min-width: 2ch; color: var(--color-accent); }
</style>
