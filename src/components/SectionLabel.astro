---
// Rótulo de seção: ponto de acento + texto.
interface Props { tag?: 'h2' | 'p'; id?: string }
const { tag = 'h2', id } = Astro.props;
const Tag = tag;
---
<Tag class="label" id={id}><span class="dot" aria-hidden="true"></span><slot /></Tag>

<style>
  .label { display: flex; align-items: center; gap: 8px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: var(--radius-pill); background: var(--color-accent); }
</style>
