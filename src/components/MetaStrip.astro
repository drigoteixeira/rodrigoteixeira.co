---
// Faixa de metadados do case: Cliente, Papel, Equipe, Ano, Escopo.
interface Props { items: { label: string; value: string }[] }
const { items } = Astro.props;
---
<section aria-label="Meta" class="container meta">
  <dl class="meta__list" style={`--n:${items.length}`}>
    {items.map((i) => (
      <div><dt>{i.label}</dt><dd>{i.value}</dd></div>
    ))}
  </dl>
</section>

<style>
  .meta { padding-top: clamp(48px, 6vw, 80px); }
  .meta__list { margin: 0; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 20px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px var(--gutter); }
  dt { margin-bottom: 6px; font-size: var(--text-label); line-height: 1.3; font-weight: 500; letter-spacing: .01em; color: var(--color-muted); }
  dd { margin: 0; line-height: 1.5; color: var(--color-ink); }
  @media (min-width: 640px) { .meta__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .meta__list { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); } }
</style>
