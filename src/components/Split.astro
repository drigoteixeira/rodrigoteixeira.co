---
// Padrão assimétrico: rótulo à esquerda, conteúdo à direita (empilhado no mobile).
// No desktop o rótulo acompanha a leitura (sticky) enquanto o texto da seção rola.
import SectionLabel from './SectionLabel.astro';
interface Props { id: string; label: string; top?: 'xl' | 'l'; index?: string }
const { id, label, top = 'l', index } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-t`} class={`split container top-${top}`}>
  <div class="grid split__grid">
    <div class="split__label reveal"><SectionLabel id={`${id}-t`} index={index}>{label}</SectionLabel></div>
    <div class="split__body reveal" style="--d:80ms"><slot /></div>
  </div>
</section>

<style>
  .split.top-xl { padding-top: var(--gap-xl); }
  .split.top-l { padding-top: var(--gap-l); }
  .split__grid { align-items: start; }
  .split__label, .split__body { grid-column: 1 / -1; }
  .split__label { margin-bottom: 20px; }
  @media (min-width: 640px) {
    .split__label { grid-column: 1 / span 2; margin: 6px 0 0; }
    .split__body { grid-column: 3 / span 6; }
  }
  @media (min-width: 1024px) {
    .split__label { grid-column: 1 / span 3; margin-top: 10px; position: sticky; top: calc(var(--header-h) + 24px); }
    .split__body { grid-column: 5 / span 7; }
  }
</style>
